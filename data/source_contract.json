{
  "search_endpoint": "https://api.usaspending.gov/api/v2/search/spending_by_award/",
  "search_request": {
    "filters": {
      "award_type_codes": [
        "A",
        "B",
        "C",
        "D"
      ],
      "agencies": [
        {
          "type": "awarding",
          "tier": "toptier",
          "name": "National Aeronautics and Space Administration"
        }
      ],
      "time_period": [
        {
          "start_date": "2024-01-01",
          "end_date": "2024-12-31",
          "date_type": "new_awards_only"
        }
      ]
    },
    "fields": [
      "Award ID",
      "generated_internal_id",
      "Base Obligation Date",
      "Awarding Agency",
      "Awarding Agency Code",
      "Contract Award Type"
    ],
    "page": 1,
    "limit": 20,
    "sort": "Award ID",
    "order": "asc",
    "subawards": false
  },
  "transactions_endpoint": "https://api.usaspending.gov/api/v2/transactions/",
  "count_endpoint": "https://api.usaspending.gov/api/v2/awards/count/transaction/{award_id}/",
  "fixed_history_limit": 5000,
  "followup_days": 365,
  "cumulative_probe_days": [
    30,
    90,
    365
  ],
  "review_capacity": 5,
  "money_field": "federal_action_obligation",
  "money_unit": "reported USD obligations; not paid cash or staff hours",
  "origin": "current Base Obligation Date source calendar assertion",
  "original_preaward_prediction": "UNEXECUTED",
  "capture_is_historical_vintage": false
}
